# Copy to .env and fill in. .env is gitignored - never commit it.

# From Meta -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# You invent this one. You type the same string into Meta's webhook config,
# and Meta echoes it back so you can prove the endpoint is yours.
WHATSAPP_VERIFY_TOKEN=

# Where the officer notifications go during the demo (your own second number)
OFFICER_NUMBER=

DATABASE_PATH=aapdaai.db

# Optional. Without it the rules parser still runs - the service reads less,
# it does not stop. Free tier from console.groq.com. Covers both text
# extraction and Whisper transcription of voice notes.
GROQ_API_KEY=

# From dashboard.ngrok.com -> Your Authtoken. Only needed if ngrok has never
# been configured on this machine.
NGROK_AUTHTOKEN=
# Optional: a reserved domain, so the URL stops changing every restart.
NGROK_DOMAIN=
